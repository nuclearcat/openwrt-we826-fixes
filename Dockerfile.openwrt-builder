# Isolated OpenWrt 24.10 build environment.
# Host stays untouched — in particular the host's uutils/bfs/ugrep setup,
# which OpenWrt's prereq check rejects (it requires GNU coreutils/findutils/grep).
FROM ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential clang flex bison g++ gawk \
        gcc-multilib g++-multilib gettext git \
        libncurses-dev libssl-dev libelf-dev \
        python3 python3-setuptools python3-dev \
        rsync unzip zlib1g-dev file wget time cpio \
        ca-certificates ecj fastjar java-propose-classpath \
        libcapture-tiny-perl libyaml-perl swig \
        qemu-utils zstd xz-utils bzip2 device-tree-compiler \
    && rm -rf /var/lib/apt/lists/*

# OpenWrt refuses to build as root; run as a user matching the host UID/GID so
# the bind-mounted tree keeps correct ownership.
ARG UID=1000
ARG GID=1000
RUN touch /var/mail/ubuntu 2>/dev/null; \
    userdel -r ubuntu 2>/dev/null || true; \
    groupdel ubuntu 2>/dev/null || true; \
    groupadd -g ${GID} builder && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash builder

USER builder
WORKDIR /build
ENV FORCE_UNSAFE_CONFIGURE=1
